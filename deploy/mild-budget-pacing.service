[Unit]
Description=Mild Budget Pacing (Google Ads)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mildpacing
Group=mildpacing
WorkingDirectory=/opt/mild-budget-pacing
EnvironmentFile=/etc/mild-budget-pacing.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Härdning
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mild-budget-pacing
StateDirectory=mild-budget-pacing

[Install]
WantedBy=multi-user.target
