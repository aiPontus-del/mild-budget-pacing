# Alla inställningar sätts som miljövariabler. Innehåller hemligheter: förvara skyddat.

# --- Webbserver ---
PORT=3000
# Adress appen lyssnar på, t.ex. 127.0.0.1 bakom en proxy på samma maskin
HOST=127.0.0.1
# Katalog för state.json (budgetar, dolda konton, larm). Ska vara beständig.
DATA_DIR=./data

# --- Inloggning till dashboarden (HTTP Basic Auth) ---
DASHBOARD_USER=mild
DASHBOARD_PASSWORD=mild

# --- Google Ads API (levereras av Pontus) ---
# Utan alla fem kör servern med testdata.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC:ns kund-ID, bara siffror
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# --- Valfritt ---
# Minuter som kontodata cachas mellan anrop
CACHE_MINUTES=5
# Minuter mellan bakgrundskontroller för notiscentret
REFRESH_MINUTES=30
# Antal konton som hämtas parallellt från Google Ads
GOOGLE_ADS_CONCURRENCY=6
# Första dag i månaden då larm för över/under budget skapas
ALERT_MIN_DAY=4
# Bara för testmiljön på Render
# REDIS_URL=
