# Kopiera till .env (Docker) eller /etc/mild-budget-pacing.env (systemd) och fyll i.
# Filen innehåller hemligheter: behörighet 600 och aldrig i Git.

# --- Webbserver ---
PORT=3000
# 127.0.0.1 när nginx ligger framför på samma maskin, 0.0.0.0 i Docker.
HOST=127.0.0.1
# Var budgetar, dolda konton och larm sparas (state.json). Ska ligga på beständig disk och backas upp.
DATA_DIR=/var/lib/mild-budget-pacing

# --- Inloggning till dashboarden (HTTP Basic Auth) ---
DASHBOARD_USER=mild
DASHBOARD_PASSWORD=

# --- Google Ads API (levereras av Pontus) ---
# Utan alla fem kör servern med testdata.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC:ns kund-ID, bara siffror
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# --- Valfritt ---
# Minuter som kontodata cachas mellan anrop
CACHE_MINUTES=5
# Minuter mellan bakgrundskontroller för notiscentret
REFRESH_MINUTES=30
# Antal konton som hämtas parallellt från Google Ads
GOOGLE_ADS_CONCURRENCY=6
# Första dag i månaden då larm för över/under budget skapas
ALERT_MIN_DAY=4
# Används inte på Milds server (filen i DATA_DIR räcker)
# REDIS_URL=
